# Secrets. Copy to .env and keep it private (chmod 600 .env).

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Claude key for chat, from https://platform.claude.com/settings/keys. Used when `provider`
# or `fallback` under [ai] in config.toml is "claude".
ANTHROPIC_API_KEY=

# Optional: an Anthropic Admin API key, so the status message and the budget warnings use
# what Anthropic actually billed instead of an estimate (read once an hour). Only
# organizations can make one, see
# https://platform.claude.com/docs/en/manage-claude/admin-api-keys
#
# ############################################################################################
# #  CAUTION: AN ADMIN KEY CAN RUN YOUR WHOLE ANTHROPIC ORGANIZATION.                         #
# #  Whoever has it can invite and remove members, change roles, and turn off or rename      #
# #  every API key. The bot only reads the cost report with it, but anyone who gets this     #
# #  file gets all of that. Keep it only in this .env on the server (chmod 600 .env), never  #
# #  in config.toml, git, screenshots or chat. If it ever leaks, delete it in the Console    #
# #  right away. Leave it empty if you don't need the real bill: the estimate still works.   #
# ############################################################################################
# ANTHROPIC_ADMIN_KEY=

# OpenAI key for chat. Used when `provider` or `fallback` under [ai] in config.toml is
# "openai". Without the chosen provider's key, chat is off.
OPENAI_TOKEN=

# Optional: an ElevenLabs key, for voice messages ([features.voice] in config.toml), from
# https://elevenlabs.io/app/settings/api-keys. It needs the Text to Speech permission.
# ELEVENLABS_API_KEY=

# Optional: a different OpenAI-compatible endpoint for chat; /v1 is added if missing.
# OPENAI_BASE=https://api.openai.com

# Optional: log level for stdout and the journal, e.g. info,vivy::features::reminders=debug
# RUST_LOG=info

# Optional: "json" for one JSON object per log line instead of readable text.
# LOG_FORMAT=json
