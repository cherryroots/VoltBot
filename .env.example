# Secrets. Copy to .env and keep it private (chmod 600 .env).

# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# OpenAI key for chat. Without it, chat is off.
OPENAI_TOKEN=

# Optional: a different OpenAI-compatible endpoint for chat; /v1 is added if missing.
# OPENAI_BASE=https://api.openai.com

# Optional: log level for stdout and the journal, e.g. info,voltbot::features::reminders=debug
# RUST_LOG=info

# Optional: "json" for one JSON object per log line instead of readable text.
# LOG_FORMAT=json
